# ============ CHRTV — biến môi trường build (Vite) ============
# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# TMDB API key (mục Phim). Lấy free tại https://www.themoviedb.org/settings/api
# Xem TMDB.md để biết hướng dẫn đầy đủ.
VITE_TMDB_KEY=c02e885e3955667731c6267bd30fa92d

# (Tuỳ chọn) Địa chỉ Worker API nếu web KHÔNG cùng domain với Worker.
# Bỏ trống = gọi API same-origin (khuyến nghị: Worker phục vụ cả dist/ lẫn /api/*).
# Ví dụ: VITE_API_BASE=https://play.ankb.qzz.io
VITE_API_BASE=

# (Chỉ dùng khi dev) Worker mà vite dev server sẽ proxy /api,/auth,/user,/admin tới.
# Mặc định: https://play.ankb.qzz.io — muốn test Worker chạy local:
#   VITE_DEV_API_TARGET=http://127.0.0.1:8787 npm run dev
VITE_DEV_API_TARGET=
